      "name": "step_01_read_event_results",
      "facets": {
        "transformationSteps": {
          "_producer": "https://openai.com/chatgpt/generate-etl-lineage",
          "_schemaURL": "https://openai.com/schemas/openlineage/transformationSteps-1-0-0.json",
          "steps": [
            {
              "sequence": 1,
              "statementType": "READ_PARQUET_SELECT",
              "inputDataFrames": [],
              "outputDataFrame": "event_result_df",
              "selectedColumns": [
                "season_year",
                "participant_name",
                "participant_nationality",
                "team_name",
                "points_awarded",
                "finish_position"
              ],
              "expression": "spark.read.parquet(source_path).select(season_year, participant_name, participant_nationality, team_name, points_awarded, finish_position)"
            },
            {
              "sequence": 2,
              "statementType": "GROUP_BY_AGG",
              "inputDataFrames": [
                "event_result_df"
              ],
              "outputDataFrame": "participant_standings_df",
              "selectedColumns": [
                "season_year",
                "participant_name",
                "participant_nationality",
                "team_name",
                "total_points",
                "wins"
              ],
              "groupByExpression": "groupBy(\"season_year\", \"participant_name\", \"participant_nationality\", \"team_name\")",
              "expression": "sum(\"points_awarded\").alias(\"total_points\"), count(when(col(\"finish_position\") == 1, True)).alias(\"wins\")"
            },
            {
              "sequence": 3,
              "statementType": "WINDOW_RANK",
              "inputDataFrames": [
                "participant_standings_df"
