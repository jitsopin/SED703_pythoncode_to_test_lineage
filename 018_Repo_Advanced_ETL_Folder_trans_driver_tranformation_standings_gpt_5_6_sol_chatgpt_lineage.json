              "selectedColumns": [
                "season_year",
                "participant_name",
                "participant_nationality",
                "team_name",
                "total_points",
                "wins",
                "standing_rank"
              ],
              "windowExpression": "Window.partitionBy(\"season_year\").orderBy(col(\"total_points\").desc(), col(\"wins\").desc())",
              "expression": "withColumn(\"standing_rank\", rank().over(participant_rank_spec))"
            },
            {
              "sequence": 4,
