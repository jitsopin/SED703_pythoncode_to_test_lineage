          "_schemaURL": "https://openai.com/schemas/openlineage/transformationSteps-1-0-0.json",
          "steps": [
            {
              "sequence": 1,
              "statementType": "READ_CSV",
              "inputDataFrames": [],
              "outputDataFrame": "event_schedule_raw_df",
              "selectedColumns": [
                "event_id",
                "season_year",
                "sequence_number",
                "venue_id",
                "event_name",
                "event_date",
                "start_time_text",
                "reference_url"
              ],
              "expression": "spark.read.option('header', True).schema(event_schedule_schema).csv(source_path)"
            },
            {
              "sequence": 2,
              "statementType": "SELECT_DERIVE",
              "inputDataFrames": [
                "event_schedule_raw_df"
              ],
              "outputDataFrame": "event_schedule_enriched_df",
              "selectedColumns": [
                "event_id",
                "season_year",
                "sequence_number",
                "venue_id",
                "event_name",
                "event_date",
                "start_time_text",
                "reference_url",
                "loaded_at_utc",
                "scheduled_start_timestamp"
              ],
              "expression": "event_schedule_raw_df.select(..., current_timestamp().alias('loaded_at_utc'), to_timestamp(concat_ws(' ', col('event_date').cast('string'), col('start_time_text')), 'yyyy-MM-dd HH:mm:ss').alias('scheduled_start_timestamp'))"
            },
            {
              "sequence": 3,
              "statementType": "SELECT",
              "inputDataFrames": [
                "event_schedule_enriched_df"
              ],
              "outputDataFrame": "published_event_calendar_df",
              "selectedColumns": [
                "event_id",
                "season_year",
                "sequence_number",
                "venue_id",
                "event_name",
                "loaded_at_utc",
                "scheduled_start_timestamp"
              ],
              "expression": "event_schedule_enriched_df.select(event_id, season_year, sequence_number, venue_id, event_name, loaded_at_utc, scheduled_start_timestamp)"
            },
            {
              "sequence": 4,
              "statementType": "WRITE_PARQUET_OVERWRITE_PARTITIONED",
              "inputDataFrames": [
                "published_event_calendar_df"
              ],
              "outputDataFrame": null,
              "selectedColumns": [
                "event_id",
                "season_year",
                "sequence_number",
                "venue_id",
                "event_name",
                "loaded_at_utc",
                "scheduled_start_timestamp"
              ],
              "expression": "published_event_calendar_df.write.mode('overwrite').partitionBy('season_year').parquet(target_path)"
            }
          ]
        }
      }
    },
